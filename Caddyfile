# 路径分流：节点路径 → sing-box，其余 → OpenList
# 单一域名（Koyeb 自带），无需 Host 改写。

{
	admin off
	auto_https off
}

:{$PORT:8000} {
	# 节点路径：WebSocket 反代到 sing-box
	handle {$NODE_PATH:/fe82f69e}* {
		reverse_proxy 127.0.0.1:{$SB_PORT:10000} {
			flush_interval -1
		}
	}

	# 其余：OpenList
	handle {
		reverse_proxy 127.0.0.1:{$OL_PORT:5244}
	}
}
